# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/medical_ai_platform
SQLITE_FALLBACK=true
SQLITE_PATH=./database/medical_ai.db
# Use false in production to fail fast if PostgreSQL is unavailable.
SEED_DEMO_DATA=true

# Production bootstrap administrator (optional; set all three together)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Configuration
# reference = local rules only; groq/openai = LLM classification + routing proposals.
# Groq has a limited Free plan. Keep that account on Free; never upgrade for this setup.
# "demo" remains an alias for reference mode. See docs/LLM_INTEGRATION_AR.md.
AI_MODE=reference
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_TIMEOUT_SECONDS=30
# TEMPERATURE is a legacy setting, unused by the structured triage request.
TEMPERATURE=0.7
MAX_TOKENS=1000

# RAG Configuration
CHROMA_PERSIST_DIR=./embeddings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg

# CORS Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Application Configuration
APP_NAME=BioMed AI Assistant
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
# Production: DEBUG=false, SQLITE_FALLBACK=false, SEED_DEMO_DATA=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
